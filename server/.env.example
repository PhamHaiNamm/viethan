# ===========================================
# VIETHAN SPORTS - SERVER ENVIRONMENT CONFIG
# ===========================================
# Sao chép file này thành .env và điền giá trị thực

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/viethan_sports
# Hoặc dùng MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/viethan_sports

# JWT
JWT_SECRET=viethan_sports_super_secret_key_change_this_in_production_2024
JWT_EXPIRES_IN=7d

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Admin mặc định (dùng khi seed)
ADMIN_EMAIL=admin@viethansports.vn
ADMIN_PASSWORD=Admin@123456

# Upload ảnh - Chọn LOCAL hoặc CLOUDINARY
UPLOAD_TYPE=local
# Nếu dùng Cloudinary:
# UPLOAD_TYPE=cloudinary
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Email thông báo khi có liên hệ mới (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=VietHan Sports <your_email@gmail.com>
EMAIL_TO=admin@viethansports.vn

# Telegram Bot (tùy chọn - thay cho email)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_MAX=5
